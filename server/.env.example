# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000
CLIENT_ORIGIN="http://localhost:5173"
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME="toktickit_session"
# Local-development seed data only. Set this in your uncommitted .env before
# running `npm run prisma:seed`; never use a real or production password.
SEED_INITIAL_PASSWORD=
